{
  "name": "nuxt-rendering-performance-comparison",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "unlighthouse:local": "unlighthouse",
    "unlighthouse:prod": "NODE_ENV=PROD unlighthouse",
    "lh:clean:tbt": "rm -f ./reports/tbt/*",
    "lh:clean:fcp": "rm -f ./reports/fcp/*",
    "lh:clean:lcp": "rm -f ./reports/lcp/*",
    "lh:clean:si": "rm -f ./reports/si/*",
    "lh:tbt:metrics": "cross-env LH_METRIC=tbt node scripts/collect-metrics.js",
    "lh:fcp:metrics": "cross-env LH_METRIC=fcp node scripts/collect-metrics.js",
    "lh:lcp:metrics": "cross-env LH_METRIC=lcp node scripts/collect-metrics.js",
    "lh:si:metrics": "cross-env LH_METRIC=si node scripts/collect-metrics.js",
    "lh:tbt": "pnpm run lh:clean:tbt && cross-env LH_METRIC=tbt lhci collect && cross-env LH_METRIC=tbt lhci upload && pnpm run lh:tbt:metrics",
    "lh:fcp": "pnpm run lh:clean:fcp && cross-env LH_METRIC=fcp lhci collect && cross-env LH_METRIC=fcp lhci upload && pnpm run lh:fcp:metrics",
    "lh:lcp": "pnpm run lh:clean:lcp && cross-env LH_METRIC=lcp lhci collect && cross-env LH_METRIC=lcp lhci upload && pnpm run lh:lcp:metrics",
    "lh:si": "pnpm run lh:clean:si && cross-env LH_METRIC=si lhci collect && cross-env LH_METRIC=si lhci upload && pnpm run lh:si:metrics",
    "lh:tbt:local": "cross-env BASE_URL=http://localhost:3000 pnpm run lh:tbt",
    "lh:fcp:local": "cross-env BASE_URL=http://localhost:3000 pnpm run lh:fcp",
    "lh:lcp:local": "cross-env BASE_URL=http://localhost:3000 pnpm run lh:lcp",
    "lh:si:local": "cross-env BASE_URL=http://localhost:3000 pnpm run lh:si",
    "lh:tbt:prod": "cross-env BASE_URL=https://nuxt-rendering-performance-comparis.vercel.app pnpm run lh:tbt",
    "lh:fcp:prod": "cross-env BASE_URL=https://nuxt-rendering-performance-comparis.vercel.app pnpm run lh:fcp",
    "lh:lcp:prod": "cross-env BASE_URL=https://nuxt-rendering-performance-comparis.vercel.app pnpm run lh:lcp",
    "lh:si:prod": "cross-env BASE_URL=https://nuxt-rendering-performance-comparis.vercel.app pnpm run lh:si"
  },
  "dependencies": {
    "@nuxt/eslint": "1.12.1",
    "@picocss/pico": "^2.1.1",
    "@sentry/nuxt": "^10",
    "eslint": "^9.39.2",
    "import-in-the-middle": "^3.0.0",
    "nuxt": "^3.20.2",
    "typescript": "^5.9.3",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "pnpm": {
    "overrides": {
      "@vercel/nft": "^0.27.4"
    }
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "cross-env": "^10.1.0",
    "unlighthouse": "^0.17.7"
  }
}
